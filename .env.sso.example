# Settings for the SSO deployment. Copy to ".env.sso" (already git-ignored),
# fill in the values and run:
#
#   docker compose --env-file .env.sso -f docker-compose.yml -f docker-compose.sso.yml up -d --build
#
# NEVER commit .env.sso: it holds the Entra client secret.

# Public HTTPS host name users type in the browser (no scheme, no path).
# Must match the redirect URI registered in Entra: https://<PUBLIC_HOST>/oauth2/callback
PUBLIC_HOST=pdf.example.co.id

# From the Entra App Registration (Overview page).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Client secret VALUE (Certificates & secrets). It expires: note the date and
# renew it before then, or logins stop working.
ENTRA_CLIENT_SECRET=

# 32 random bytes, URL-safe base64. Generate on Linux with:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=

# Who may open the "Report" tab: sign-in names (UPN) separated by commas.
REPORT_ADMINS=admin@example.co.id

# Reverse proxies in front of the API: nginx + the company TLS proxy = 2.
TRUST_PROXY=2
