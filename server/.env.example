# ── Server ─────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed origins for CORS (the web app URL)
CORS_ORIGIN=http://localhost:5173

# Max upload size per file in MB
MAX_FILE_MB=50
# Max number of files per request (used by merge)
MAX_FILES=20

# Trust proxy / client IP resolution for rate limiting.
#   unset / false / 0  -> don't trust proxies (use when directly exposed)
#   1, 2, ...          -> number of trusted reverse-proxy hops in front
#   true               -> trust all hops (NOT recommended — X-Forwarded-For is spoofable)
#   10.0.0.0/8         -> a trusted subnet/IP (passed to Express as-is)
# Behind a single nginx/LB, set this to 1.
TRUST_PROXY=

# Ghostscript run limits (DoS protection).
# Seconds before a single run is killed (422 is returned):
GS_TIMEOUT_SEC=60
# Simultaneous Ghostscript processes:
GS_MAX_CONCURRENT=2
# Requests allowed to wait for a free slot; more than this get 503:
GS_MAX_QUEUE=5
